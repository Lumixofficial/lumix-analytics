{
  "name": "lumix-analytics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --require ./tests/register.cjs --test tests/*.test.cjs",
    "visitors:setup": "node scripts/visitors-local.mjs setup",
    "visitors:db": "node scripts/visitors-local.mjs db",
    "visitors:up": "node scripts/visitors-local.mjs up",
    "visitors:down": "node scripts/visitors-local.mjs down",
    "visitors:reset": "node scripts/visitors-local.mjs reset",
    "visitors:secrets:production": "node scripts/visitors-local.mjs production-secrets",
    "visitors:verify-mongo": "node scripts/verify-mongo-migration.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "mongodb": "7.7.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0"
  }
}
