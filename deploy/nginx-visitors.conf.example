# Integrate into the actual HTTPS vhost; this is not a complete nginx config.
# The Next host port must remain loopback-bound. Do not expose it around this ingress.
# In http{}: limit_req_zone $server_name zone=visitor_global:1m rate=5r/s;
# HTTP vhost: return 308 https://$host$request_uri; (no Basic challenge over HTTP)

# Review error/CDN/WAF/APM logs separately. access_log off does not suppress them.
access_log off;
location = /api/visitors {
    client_max_body_size 256;
    client_body_timeout 2s;
    limit_req zone=visitor_global burst=20 nodelay;
    proxy_request_buffering off;
    proxy_set_header Host $host;
    # OVERWRITE any caller-supplied header. If behind a CDN, configure nginx's
    # real_ip module ONLY for explicitly trusted CDN addresses first.
    proxy_set_header X-Lumix-Client-IP $remote_addr;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header Forwarded "";
    proxy_pass http://127.0.0.1:3004;
}
location / {
    proxy_set_header Host $host;
    proxy_set_header X-Lumix-Client-IP $remote_addr;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header Forwarded "";
    proxy_pass http://127.0.0.1:3004;
    add_header Referrer-Policy no-referrer always;
}
