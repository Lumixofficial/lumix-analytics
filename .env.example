# Docker deployment: copy to .env next to docker-compose.yml.
# Local `next dev` uses .env.local with NEXT_PUBLIC_API_URL=http://localhost:8080.

# Port inside the container. The host port (127.0.0.1:3004) is set in docker-compose.yml.
PORT=3000
NODE_ENV=production

# Public analytics API base URL. Inlined at build time; rebuild after changing it.
NEXT_PUBLIC_API_URL=https://api.lumixmarket.com

# This app reads no Stellar network or contract variables. The API owns them
# (EXPECTED_NETWORK=pubnet, SWAP_AGGREGATOR_CONTRACT_ID), and transaction links
# always open Mainnet Stellar Expert.

# Private first-party visitor counts. Runtime configuration; disabled by default.
# Read docs/visitor-analytics.md and complete its deployment review before enabling.
VISITOR_ANALYTICS_ENABLED=false
VISITOR_FRONT_ENABLED=false
VISITOR_FRONT_ORIGIN=
VISITOR_FRONT_REVIEW_ID=
VISITOR_FRONT_UNIQUES_ENABLED=false
VISITOR_FRONT_UNIQUES_REVIEW_ID=
VISITOR_ANALYTICS_MODE=disabled
VISITOR_ANALYTICS_DATASET=production
VISITOR_ANALYTICS_REVIEW_ID=
VISITOR_ANALYTICS_LOG_REVIEWED=false
VISITOR_ANALYTICS_ORIGIN=
# Dedicated database on the existing Mongo service. Production requires credentials.
# Example only: mongodb://visitors:PASSWORD@mongo-lumix:27017/lumix_visitors?authSource=lumix_visitors
VISITOR_ANALYTICS_MONGODB_URI=
# Docker sets VISITOR_ANALYTICS_MONGODB_URI_FILE to a read-only secret mount.
# For a native server, either URI or URI_FILE is accepted; never use NEXT_PUBLIC_*.
VISITOR_ANALYTICS_RETENTION_DAYS=30
VISITOR_ANALYTICS_MAX_PER_MINUTE=300
# Optional daily network estimator. A pageview exemption is not its approval.
VISITOR_ANALYTICS_UNIQUES_ENABLED=false
VISITOR_ANALYTICS_UNIQUES_REVIEW_ID=
# Enable only after an isolated ingress OVERWRITES X-Lumix-Client-IP.
VISITOR_ANALYTICS_TRUST_PROXY=false
# Protected admin: Docker mounts a generated salted password hash.
VISITOR_ADMIN_USERNAME=admin
VISITOR_ADMIN_PASSWORD_HASH=
# VISITOR_ADMIN_PASSWORD_HASH_FILE=/run/secrets/visitor_admin_hash
# These fields are public privacy-notice text. Never put credentials in them.
VISITOR_ANALYTICS_CONTROLLER=
VISITOR_ANALYTICS_CONTACT_EMAIL=
VISITOR_ANALYTICS_EXEMPTION=
VISITOR_ANALYTICS_HOSTING=
VISITOR_ANALYTICS_PROCESSORS=
VISITOR_ANALYTICS_TRANSFERS=
