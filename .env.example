# Docker deployment: copy to .env next to docker-compose.yml.
# Local `next dev` uses .env.local with NEXT_PUBLIC_API_URL=http://localhost:8080.

# Port inside the container. The host port (127.0.0.1:3004) is set in docker-compose.yml.
PORT=3000
NODE_ENV=production

# Public analytics API base URL. Inlined at build time; rebuild after changing it.
NEXT_PUBLIC_API_URL=https://api.lumixmarket.com

# This app reads no Stellar network or contract variables. The API owns them
# (EXPECTED_NETWORK=pubnet, SWAP_AGGREGATOR_CONTRACT_ID), and transaction links
# always open Mainnet Stellar Expert.
